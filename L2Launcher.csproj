<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.2</Version>
    <Company>Ascension</Company>
    <Product>Ascension Lineage II Launcher</Product>
    <AssemblyName>LineageII</AssemblyName>
    <RootNamespace>L2Launcher</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\ascension-icon.ico</ApplicationIcon>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="SigningTool\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\ascension-art.png" />
    <Resource Include="Resources\ascension-icon.png" />
    <Resource Include="Resources\ascension-icon.ico" />
    <EmbeddedResource Include="Resources\launcher-signing-public.pem"
                      LogicalName="L2Launcher.Resources.launcher-signing-public.pem" />
    <Content Include="launcher.settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="launcher.settings.json.sig">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
